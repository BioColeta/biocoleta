APP_ENV=local

# Shared secret for simulator / device POSTs (X-Device-Key)
DEVICE_KEY=change-me

# MariaDB PDO
DB_DSN=mysql:host=127.0.0.1;port=3306;dbname=biocoleta;charset=utf8mb4
DB_USER=biocoleta
DB_PASSWORD=

# Optional overrides (defaults point at repo frontend/)
# VIEWS_PATH=/absolute/path/to/frontend/views
# ASSETS_PATH=/absolute/path/to/frontend/assets

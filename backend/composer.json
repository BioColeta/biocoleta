{
  "name": "biocoleta/backend",
  "description": "BioColeta MVP PHP backend",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": "^8.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "BioColeta\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "BioColeta\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "test:unit": "phpunit --testsuite Unit"
  }
}
